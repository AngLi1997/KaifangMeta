# KaifangMetaPlatform 统一配置（后端、前端、docker-compose、start-service.sh 共用）
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 应用 ----
APP_TITLE=KaifangMeta
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

# ---- 前端（nova-admin；浏览器只拿到 VITE_* 与 CONSOLE_CLIENT_ID）----
VITE_APP_NAME=KaifangMeta
VITE_PORT=3001
VITE_BASE_URL=/
VITE_BASE_API=/kaifang-meta/console/api/v1
VITE_ROUTE_MODE=web
VITE_HOME_PATH=/workbench
VITE_DEFAULT_LANG=zhCN
VITE_STORAGE_PREFIX=km_
VITE_COPYRIGHT_INFO="Copyright © 2026 KaifangMetaPlatform"
VITE_BUILD_COMPRESS=Y
VITE_COMPRESS_TYPE=gzip

# ---- 认证模块（OIDC 授权码 + PKCE，RS256 + JWKS）----
# 签发方须是网关地址；APISIX 容器内经 127.0.0.1:9080 访问自身，改 APISIX_HTTP_PORT 时同步修改
IAM_ISSUER=http://localhost:9080/kaifang-meta/iam
IAM_SCHEMA=iam
IAM_ACCESS_TOKEN_TTL=900
IAM_REFRESH_TOKEN_TTL=28800
IAM_SSO_SESSION_TTL=28800
IAM_COOKIE_SECURE=false
IAM_SERVICE_TOKEN_TTL=600
IAM_KEY_CACHE_TTL=300
IAM_LOGIN_RATE_LIMIT_PER_MIN=20
# 平台 API 路由（/kaifang-meta/platform/*）的 aud 与网关签名密钥
PLATFORM_CLIENT_ID=kaifang-meta-platform
PLATFORM_GATEWAY_SECRET=change-me-openssl-rand-hex-32

# ---- 平台控制台（内置应用，模式 A 网关托管）----
CONSOLE_CLIENT_ID=kaifang-meta-console
CONSOLE_REDIRECT_URIS=http://localhost:3001/auth/callback
CONSOLE_POST_LOGOUT_REDIRECT_URIS=http://localhost:3001/
CONSOLE_GATEWAY_PREFIX=/kaifang-meta/console
# 网关与控制台共享的身份头签名密钥（app_gateway_secret）
CONSOLE_GATEWAY_SECRET=change-me-openssl-rand-hex-32
# 控制台接收平台事件（不经网关，HMAC 验签）
CONSOLE_EVENT_ENDPOINT=http://127.0.0.1:8080/kaifang-meta/console/api/v1/events
CONSOLE_EVENT_SECRET=change-me-openssl-rand-hex-32
CONSOLE_RATE_LIMIT_QPS=200
# APISIX 容器访问平台进程的全部节点（主机 IP:端口，逗号分隔）
PLATFORM_UPSTREAM_NODES=host.docker.internal:8080
APISIX_ADMIN_URL=http://127.0.0.1:9180

# ---- PostgreSQL（pgvector）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kaifang-meta-platform
# 控制台权限数据所在 schema（docs/platform/auth/authz.md）
POSTGRES_SCHEMA=console_authz
# 平台运行时数据库账号（非超级用户，受 RLS 约束），由 alembic 创建
POSTGRES_APP_USER=kaifang_meta_app
POSTGRES_APP_PASSWORD=change-me-app-password
# 每个进程每个模块一个连接池的上限（进程数 × 2 × 该值 需小于 PostgreSQL max_connections）
POSTGRES_POOL_MAX=10

# 首个超级管理员：身份账号 + 控制台本地用户（alembic seed 写入，仅首次生效）
CONSOLE_ADMIN_USERNAME=admin
CONSOLE_ADMIN_PASSWORD=123456
CONSOLE_ADMIN_EMAIL=admin@admin.com

# ---- Redis（无密码）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO ----
MINIO_PORT=9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=kaifang-meta-platform
MINIO_SECURE=false

# ---- APISIX 网关（默认端口）----
APISIX_HTTP_PORT=9080
APISIX_HTTPS_PORT=9443
APISIX_ADMIN_PORT=9180
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1
ETCD_PORT=2379
ETCD_WORKBENCH_PORT=9010
